    "import seaborn as sns\n",
    "from sklearn.pipeline import Pipeline\n",
    "from scipy as cp\n",
    "from matplotlib.patches import Patch\n",
    "from matplotlib import cm\n",
    "from sklearn.model_selection import GridSearchCV, StratifiedKFold"
   ]
  },
