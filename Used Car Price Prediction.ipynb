   "source": [
    "## 2.7 Using log for skewed variables.\n",
    "\n",
    "We will use log transformation so that each skewed variable's data normaly distributed."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 122,
   "id": "72bade1a",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Before Transformation:\n",
      "selling_price: 4.19\n",
      "max_power: 1.64\n",
      "engine: 1.15\n",
      "torque: 1.08\n",
      "year: -1.07\n",
      "\n",
      "After Transformation:\n",
      "selling_price: 0.22\n",
      "max_power: -1.03\n",
      "engine: 0.41\n",
      "torque: -1.40\n",
      "year: -1.08\n"
     ]
    }
   ],
   "source": [
    "import numpy as np\n",
    "\n",
    "cols = [\"selling_price\", \"max_power\", \"engine\", \"torque\", \"year\"]\n",
    "\n",
    "print(\"Before Transformation:\")\n",
    "for col in cols:\n",
    "    print(f\"{col}: {df[col].skew():.2f}\")\n",
    "\n",
    "for col in cols:\n",
    "    df[col] = np.log1p(df[col])\n",
    "\n",
    "print(\"\\nAfter Transformation:\")\n",
    "for col in cols:\n",
    "    print(f\"{col}: {df[col].skew():.2f}\")"
   ]
